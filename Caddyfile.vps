# /opt/lucie/Caddyfile — COPIE DE RÉFÉRENCE DE CE QUI TOURNE SUR LE VPS OVH.
#
# Ce fichier n'est pas un modèle : c'est le double, dans le dépôt, de celui qui
# est monté en lecture seule dans le conteneur `lucie-caddy`. Le dépôt portait
# auparavant un exemple avec un nom fictif et un Caddy installé sur l'hôte ;
# décrire une installation qui n'existe pas est pire qu'un fichier absent — la
# prochaine session y croit.
#
# Caddy termine le TLS ; nginx (frontend) écoute en 80 et fait lui-même le
# proxy_pass vers le backend. Caddy ne route donc PAS /api/*, et le navigateur
# ne parle qu'à UNE origine : le CORS n'entre jamais en jeu en usage normal.
#
# Recharger sans coupure :
#   docker exec lucie-caddy caddy reload --config /etc/caddy/Caddyfile

(commun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# RIEN ICI N'A VOCATION À ÊTRE INDEXÉ. Lucie est une application
		# d'administration : ni la production ni le développement n'ont
		# d'audience publique, et le développement porte en outre des données
		# réelles. L'en-tête vit dans le bloc commun pour qu'aucun des deux ne
		# puisse l'oublier.
		X-Robots-Tag "noindex, nofollow"
	}
}

# ----------------------------------------------------------------- PROD
lucie-iip.be {
	redir https://www.lucie-iip.be{uri} permanent
}

www.lucie-iip.be {
	import commun
	reverse_proxy frontend:80
}

# ------------------------------------------------------------------ DEV
dev.lucie-iip.be {
	import commun
	header X-Lucie-Env "DEVELOPPEMENT"

	# LE DÉVELOPPEMENT EST SUR INTERNET DEPUIS LE DÉMÉNAGEMENT, et il tourne en
	# NODE_ENV=development : la route de restauration de la base y est ouverte.
	# C'est voulu — c'est ainsi qu'on y remet une copie des données réelles —
	# mais ce qui était protégé par le fait d'être injoignable de l'extérieur ne
	# l'est plus que par l'authentification de l'application.
	#
	# Deux façons de refermer l'écart, au choix :
	#
	# 1. Par adresse, quand elles seront connues — simple, mais fragile avec des
	#    connexions domestiques dont l'adresse change :
	# @interdit not remote_ip 1.2.3.4 5.6.7.8
	# respond @interdit 403
	#
	# 2. Par mot de passe — tient partout, et ne dépend pas du réseau.
	#    Engendrer le condensat : caddy hash-password --plaintext 'le-mot'
	# basic_auth {
	# 	iip $2a$14$remplacer_par_le_condensat_engendre
	# }

	reverse_proxy frontend-dev:80
}

# Ancien nom, redirige vers le nouveau. À retirer plus tard.
vps-7c1bfaa0.vps.ovh.net {
	redir https://dev.lucie-iip.be{uri} permanent
}
