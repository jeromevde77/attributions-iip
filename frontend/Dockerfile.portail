# LE SITE DES ÉTUDIANTS — une image à part (3.1.477, le mur) : elle ne contient que dist-portail.
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npx vite build --config vite.portail.config.js

FROM nginx:stable
COPY --from=build /app/dist-portail /usr/share/nginx/html
COPY nginx-portail.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
