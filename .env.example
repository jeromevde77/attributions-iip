# Copier en .env et adapter.
#
# ─── CE QUE LE VPS OVH EXIGE (docker-compose.vps.yml) ────────────────────────
# Ces trois variables sont réclamées en `${...:?}` : si l'une manque,
# `docker compose up` ÉCHOUE au lieu de démarrer à moitié.

# Jetons de session. Deux clés distinctes, une par environnement : un jeton
# émis sur dev ne doit pas ouvrir la production.
#   openssl rand -base64 48
JWT_SECRET_DEV=change-me-with-a-real-secret
JWT_SECRET_PROD=change-me-with-a-real-secret

# Clé qui chiffre les secrets du second facteur (TOTP). 32 octets, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# LA MÊME POUR DEV ET POUR PROD, ET C'EST VOULU : la base de dev est une COPIE
# de celle de prod (Configuration → Sauvegardes → restauration). Avec deux clés
# distinctes, chaque restauration rendrait illisibles tous les secrets déjà
# enrôlés, et personne ne pourrait plus se connecter à dev.
#
# ELLE NE SE CHANGE PAS. Une nouvelle clé rend illisibles tous les secrets déjà
# enrôlés : chacun devrait reconfigurer son application d'authentification.
# Sans elle, le backend REFUSE DE DÉMARRER — à déclarer AVANT `docker compose
# pull && up -d`, sinon le service ne remonte pas.
MFA_KEY=

# ─── HÉRITAGE — INSTALLATION NAS SYNOLOGY, HORS SERVICE DEPUIS LE 17/09/2026 ─
# Conservées parce que docker-compose.synology.yml et .ssl.yml les lisent
# encore. Le VPS ne s'en sert pas : le frontend nginx fait lui-même le
# proxy_pass vers `backend:3001`, donc une seule origine et pas de CORS.

# Port HTTP exposé (défaut 8080)
HTTP_PORT=8080

# Origines autorisées pour CORS — liste séparée par des virgules
CORS_ORIGIN=http://localhost:8080
